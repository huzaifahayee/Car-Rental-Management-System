generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  EMPLOYEE
  CUSTOMER
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  INACTIVE
}
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RentalMode {
  WITH_DRIVER
  SELF_DRIVE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  phone        String?
  cnic         String?  @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  bookings     Booking[]
}

model VehiclePackage {
  id            Int          @id @default(autoincrement())
  category      String
  make          String
  model         String
  // Nullable for backward compat with vehicles created before these fields existed
  variant           String?
  year              Int?
  registrationPlate String?
  seatingCapacity Int
  transmission  Transmission
  hasAC         Boolean
  driverOption  Boolean
  pricePerDay   Int
  pickupCity    String
  dropoffCity   String
  status        VehicleStatus @default(AVAILABLE)
  isArchived    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  imageUrls String[] @default([])

  bookings      Booking[]
}

model Outlet {
  id          Int      @id @default(autoincrement())
  name        String
  city        String
  addressText String
  latitude    Float
  longitude   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  bookings    Booking[]
}

model Driver {
  id        Int          @id @default(autoincrement())
  fullName  String
  phone     String
  status    DriverStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  bookings  Booking[]
}

model Booking {
  id               Int           @id @default(autoincrement())
  bookingReference String        @unique
  status           BookingStatus @default(PENDING)
  pickupDateTime   DateTime
  returnDateTime   DateTime
  paymentMethod    String
  paymentReference String?
  createdAt        DateTime      @default(now())

  // Rental mode — nullable for backward compat with existing rows
  rentalMode       RentalMode?

  // With-Driver: geocoded pickup/dropoff addresses
  pickupAddress    String?
  pickupLat        Float?
  pickupLng        Float?
  dropoffAddress   String?
  dropoffLat       Float?
  dropoffLng       Float?

  // Self-Drive: outlet reference
  outletId         Int?
  outlet           Outlet?       @relation(fields: [outletId], references: [id])

  // With-Driver: assigned driver (nullable — assigned by an admin after booking, not at creation)
  driverId         Int?
  driver           Driver?       @relation(fields: [driverId], references: [id])

  customerId       Int
  customer         User          @relation(fields: [customerId], references: [id])

  vehiclePackageId Int
  vehiclePackage   VehiclePackage @relation(fields: [vehiclePackageId], references: [id])
}

model Settings {
  id           Int    @id @default(autoincrement())
  agencyName   String
  contactEmail String
  contactPhone String?
  logoUrl      String?
  themePalette String @default("default")
}