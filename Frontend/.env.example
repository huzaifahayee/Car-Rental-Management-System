# Backend port. The frontend derives the full backend URL from the current
# page hostname + this port (e.g. al-rafay-motors.localhost:5173 -> talks to
# al-rafay-motors.localhost:5000) so tenant-subdomain routing works in dev.
VITE_API_PORT=5000

# Uncomment to hard-override the backend URL instead (e.g. a deployed
# backend on a different host). When set, this takes priority over the
# hostname-derived URL above and subdomain routing to this backend breaks.
# VITE_API_BASE_URL=http://localhost:5000
